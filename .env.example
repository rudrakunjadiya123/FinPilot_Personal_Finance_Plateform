# ═══════════════════════════════════════════════════════════
# FINPILOT — Environment Configuration (Example)
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ── Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finpilot?schema=public"

# ── Redis ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT Secrets ────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── LLM API ───────────────────────────────────────────────
LLM_API_KEY=
LLM_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ── Email (SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Encryption ────────────────────────────────────────────
# Must be exactly 32 bytes (64 hex characters) for AES-256
FIELD_ENCRYPTION_KEY=

# ── App Config ────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CHAT_RATE_LIMIT_PER_HOUR=20
