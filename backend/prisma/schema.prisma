// ═══════════════════════════════════════════════════════════
// FINPILOT — Prisma Schema
// PostgreSQL + pgvector for note embeddings
// ═══════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── User ──────────────────────────────────────────────────
model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  passwordHash        String
  currency            String   @default("INR")
  monthlyIncomeTarget Decimal? @db.Decimal(12, 2)
  reminderDaysBefore  Int      @default(3)
  reminderEmailOn     Boolean  @default(true)
  createdAt           DateTime @default(now())

  loans             Loan[]
  lendBorrowRecords LendBorrowRecord[]
  incomeEntries     IncomeEntry[]
  chatSessions      ChatSession[]
  reminderLogs      ReminderLog[]
  financialGoals    FinancialGoal[]

  // Module 12 Hooks
  statementUploads         StatementUpload[]
  transactions             Transaction[]
  merchantCategoryRules    MerchantCategoryRule[]
  monthlyInvestments       MonthlyInvestment[]
  loanMatchSuggestions     LoanMatchSuggestion[]
}

// ── Loan ──────────────────────────────────────────────────
model Loan {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanType           String   // home | personal | auto | education | other
  lenderName         String?  // e.g. HDFC, ICICI, SBI, Axis, etc.
  principalAmount    Decimal  @db.Decimal(12, 2)
  interestRate       Decimal  @db.Decimal(5, 2)
  tenureMonths       Int
  emiAmount          Decimal  @db.Decimal(12, 2)
  startDate          DateTime
  status             String   @default("active") // active | closed
  outstandingBalance Decimal  @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime @default(now())

  emiSchedule          EMISchedule[]
  noteEmbedding        NoteEmbedding[]
  financialGoals       FinancialGoal[]
  loanMatchSuggestions LoanMatchSuggestion[]

  @@index([userId])
}

// ── EMI Schedule ──────────────────────────────────────────
model EMISchedule {
  id                 String    @id @default(uuid())
  loanId             String
  loan               Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  month              Int
  dueDate            DateTime
  principalComponent Decimal   @db.Decimal(12, 2)
  interestComponent  Decimal   @db.Decimal(12, 2)
  balanceAfter       Decimal   @db.Decimal(12, 2)
  paidStatus         String    @default("unpaid") // paid | unpaid
  paidDate           DateTime?

  @@index([loanId, dueDate])
}

// ── Lend/Borrow Record ───────────────────────────────────
model LendBorrowRecord {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personName         String
  personEmail        String
  amount             Decimal  @db.Decimal(12, 2)
  type               String   // lent | borrowed
  dateGiven          DateTime
  expectedReturnDate DateTime
  interestRate       Decimal? @db.Decimal(5, 2)
  status             String   @default("pending") // pending | partial | repaid
  notes              String?
  // Interest Configuration Fields
  interestType       String   @default("simple") // "simple" | "compound"
  compoundingFrequency Int?     // e.g. 1 (monthly), 12 (yearly)
  interestStartDate  DateTime?
  interestRateHistory Json?     // Array mapping historical rates: [{ date: "YYYY-MM-DD", rate: 5.5 }]

  createdAt          DateTime @default(now())

  repayments    RepaymentHistory[]
  noteEmbedding NoteEmbedding[]

  paymentMode         String       @default("cash") // "cash" | "online"
  transactionId       String?
  verificationStatus  String       @default("not_required") // "not_required" | "pending_verification" | "verified"
  linkedTransactionId String?
  linkedTransaction   Transaction? @relation(fields: [linkedTransactionId], references: [id])

  @@index([userId, expectedReturnDate])
}

// ── Repayment History ─────────────────────────────────────
model RepaymentHistory {
  id               String           @id @default(uuid())
  lendBorrowId     String
  lendBorrowRecord LendBorrowRecord @relation(fields: [lendBorrowId], references: [id], onDelete: Cascade)
  amount           Decimal          @db.Decimal(12, 2)
  date             DateTime
  paymentType      String           @default("principal_only") // "principal_only" | "interest_only" | "principal_interest"
  principalAmount  Decimal          @db.Decimal(12, 2) @default(0)
  interestAmount   Decimal          @db.Decimal(12, 2) @default(0)
  paymentMode         String       @default("cash") // "cash" | "online"
  transactionId       String?
  verificationStatus  String       @default("not_required") // "not_required" | "pending_verification" | "verified"
  linkedTransactionId String?
  linkedTransaction   Transaction? @relation(fields: [linkedTransactionId], references: [id])
}

// ── Income Entry ──────────────────────────────────────────
model IncomeEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String   // salary | freelance | other
  amount    Decimal  @db.Decimal(12, 2)
  month     DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Chat Session ──────────────────────────────────────────
model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId])
}

// ── Chat Message ──────────────────────────────────────────
model ChatMessage {
  id                  String      @id @default(uuid())
  sessionId           String
  session             ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role                String      // user | assistant
  content             String
  redactedPayloadSent Json?       // stored for "show what AI sees" feature
  pathUsed            String?     // "function_call" | "rag"
  createdAt           DateTime    @default(now())

  @@index([sessionId])
}

// ── Note Embedding (pgvector) ─────────────────────────────
// The `embedding` column is managed via raw SQL ($executeRaw) since
// Prisma doesn't natively support the vector type.
model NoteEmbedding {
  id               String            @id @default(uuid())
  userId           String
  recordId         String
  recordType       String            // "loan" | "lendBorrow"
  content          String
  loanId           String?
  loan             Loan?             @relation(fields: [loanId], references: [id], onDelete: Cascade)
  lendBorrowId     String?
  lendBorrowRecord LendBorrowRecord? @relation(fields: [lendBorrowId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  // embedding vector(768)  -- added via raw SQL, pgvector extension

  @@unique([recordId, recordType])
  @@index([userId])
}

// ── Reminder Log ──────────────────────────────────────────
model ReminderLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String   // "emi" | "lend_borrow" | "credit_card" | "monthly_summary"
  relatedRecordId String
  status          String   @default("sent") // "sent" | "failed"
  errorMessage    String?
  sentAt          DateTime @default(now())
  channel         String   @default("email")

  @@index([userId])
  @@index([relatedRecordId, type])
}

// ── Financial Goal (Module 11) ────────────────────────────
model FinancialGoal {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalType          String   // "savings" | "debt_payoff"
  name              String   // e.g. "Car Fund", "Clear Personal Loan Early"

  // Savings goal fields
  targetAmount      Decimal? @db.Decimal(12, 2)
  currentSaved      Decimal? @db.Decimal(12, 2) @default(0)
  targetDate        DateTime?

  // Debt payoff goal fields
  loanId            String?
  loan              Loan?    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  targetMonths      Int?     // desired payoff time, shorter than loan's remaining default tenure

  status            String   @default("active") // active | achieved | abandoned
  createdAt         DateTime @default(now())

  progressLogs      GoalProgressLog[]

  @@index([userId, status])
}

model GoalProgressLog {
  id        String   @id @default(uuid())
  goalId    String
  goal      FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)   // amount added this update (savings goals only)
  date      DateTime @default(now())
  note      String?
}

// ── Module 12: AI Bank Statement Intelligence ────────────────
model StatementUpload {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName              String
  fileType              String   // "pdf" | "csv"
  statementType         String   @default("bank_account") // "bank_account" | "credit_card"
  bankName              String?
  month                 DateTime
  status                String   @default("processing") // processing | parsed | categorizing | completed | failed
  uploadedAt            DateTime @default(now())

  // Cost/quality tracking (Section 2.2)
  totalTransactions     Int      @default(0)
  ruleMatchedCount      Int      @default(0)
  fuzzyMatchedCount     Int      @default(0)
  embeddingMatchedCount Int      @default(0)
  llmFallbackCount      Int      @default(0)
  manualReviewCount     Int      @default(0)

  transactions          Transaction[]

  @@index([userId, month])
}

model Transaction {
  id                    String          @id @default(uuid())
  statementUploadId     String
  statementUpload       StatementUpload @relation(fields: [statementUploadId], references: [id], onDelete: Cascade)
  userId                String
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                  DateTime
  descriptionRaw        String
  descriptionNormalized String          @default("")
  refNo                 String?
  amount                Decimal         @db.Decimal(12, 2)
  type                  String          // "debit" | "credit"
  balance               Decimal?        @db.Decimal(12, 2)
  category              String?         // null until categorized
  categorySource        String?         // "rule" | "fuzzy" | "embedding" | "llm" | "manual"
  confidenceScore       Decimal?        @db.Decimal(4, 3)
  needsReview           Boolean         @default(false)
  createdAt             DateTime        @default(now())

  @@index([userId, date])
  @@index([statementUploadId])

  lendBorrowRecords LendBorrowRecord[]
  repaymentHistories RepaymentHistory[]
  loanMatchSuggestions LoanMatchSuggestion[]
}

model MerchantCategoryRule {
  id                        String   @id @default(uuid())
  userId                    String
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern                   String   // normalized merchant string or regex pattern
  category                  String
  createdFromUserCorrection Boolean  @default(false)
  createdAt                 DateTime @default(now())

  @@index([userId, pattern])
}

model MonthlyInvestment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     DateTime
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
}

// ── Loan Match Suggestion (3-Factor AI Loan Auto-Matching) ────
model LoanMatchSuggestion {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanId        String
  loan          Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  matchReason   String      // e.g. "Factor 1 (Lender HDFC) & Factor 2 (EMI ₹21,500) matched"
  factors       Json?       // e.g. { factor1: true, factor2: true, factor3: "partial" }
  status        String      @default("pending") // pending | accepted | rejected
  createdAt     DateTime    @default(now())

  @@index([userId, status])
}
